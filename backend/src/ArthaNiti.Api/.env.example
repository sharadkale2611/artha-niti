# ==========================================
# DATABASE
# ==========================================

DB_CONNECTION=Server=your server Name;Database=ArthaNitiDb;Trusted_Connection=True;TrustServerCertificate=True;

DB_CONNECTION_LOCAL=Server=DESKTOP-BRPE7R0;Database=ArthaNitiDb;Trusted_Connection=True;TrustServerCertificate=True;


# ==========================================
# SUPER ADMIN
# ==========================================

ADMIN_EMAIL=admin@arthaniti.com
ADMIN_PASSWORD=Admin@123

# ==========================================
# JWT
# ==========================================

JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ISSUER=ArthaNiti
JWT_AUDIENCE=ArthaNitiClient
JWT_EXPIRY_MINUTES=60


# ==========================================
# IDENTITY ROLES
# ==========================================

IDENTITY_ROLES=SuperAdmin,Admin,User


# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=Information
EF_CORE_LOG_LEVEL=Warning


# ==========================================
# SMTP EMAIL SETTINGS
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=ArthaNiti


# ==========================================
# OTP SETTINGS
# ==========================================

REGISTRATION_OTP_EXPIRY_MINUTES=10
REGISTRATION_OTP_RESEND_SECONDS=60
REGISTRATION_MAX_OTP_ATTEMPTS=5


# ==========================================
# SWAGGER
# ==========================================

SWAGGER_TITLE=ArthaNiti API
SWAGGER_VERSION=v1
SWAGGER_DESCRIPTION=ArthaNiti Backend API
SWAGGER_ENABLED=true
